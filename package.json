{
  "name": "darts-tournament",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:checkin": "tsc -b && tsc -p cloudflare/checkin/tsconfig.json && vite build --config vite.checkin.config.ts",
    "build:animation-preview": "tsc -b && vite build --config vite.animation-preview.config.ts && node scripts/check-animation-preview.mjs",
    "preview:animation-preview": "vite preview --config vite.animation-preview.config.ts",
    "dev": "node scripts/local-app.mjs dev",
    "dev:legacy": "vite --config vite.rehearsal.config.ts",
    "local:setup": "node scripts/local-app.mjs setup",
    "local:query": "node scripts/local-app.mjs query",
    "dev:rehearsal": "node scripts/local-app.mjs dev",
    "dev:legacy-rehearsal": "vite --config vite.rehearsal.config.ts --host 127.0.0.1 --port 5175 --strictPort",
    "test:rehearsal": "vitest run --config vite.rehearsal.config.ts",
    "build": "npm run build:checkin",
    "build:legacy": "tsc -b && vite build",
    "preview": "node scripts/local-app.mjs preview",
    "preview:legacy": "vite preview",
    "deploy:check": "npm run build && node scripts/check-deployment.mjs",
    "deploy:rehearsal": "npm run build && node node_modules/wrangler/bin/wrangler.js deploy --config cloudflare/checkin/wrangler.through-rehearsal.jsonc",
    "test": "vitest run",
    "test:e2e:local": "node scripts/verify-through-rehearsal.cjs --local",
    "test:entry:local": "node scripts/verify-local-entry.cjs",
    "test:e2e:32": "node scripts/verify-rehearsal32.cjs",
    "test:e2e:32:public": "node scripts/verify-rehearsal32.cjs --public --show",
    "cf:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cf:dev": "node scripts/local-app.mjs dev"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@supabase/supabase-js": "^2.49.1",
    "brackets-manager": "^1.11.0",
    "brackets-memory-db": "^1.0.6",
    "events": "^3.3.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
