# Legacy Supabase版専用（npm run dev:legacy）。現在のCloudflare版では使用しません。
# npm run dev は cloudflare/local/.dev.vars を初回生成します。手順は README.md を参照。
# Supabase プロジェクト URL（末尾に /rest/v1/ は付けない）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_PASSCODE=changeme
# デモ公開時: 1 にすると /admin パスコード不要 + トップにデモ案内
VITE_DEMO_MODE=0
