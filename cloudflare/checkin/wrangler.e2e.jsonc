{
  "name": "tournament-checkin-e2e",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist-checkin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tournament-rehearsal-db",
      "database_id": "0a7528e1-7f14-4e54-a896-4fbe2cf2c42c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTRAITS",
      "bucket_name": "tournament-rehearsal-portraits"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "CHECKIN_EVENT_ID": "cf-checkin-e2e-20261025"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
